{
  "name": "@darkmatter2222/opencode-mastergoal",
  "version": "0.4.0",
  "description": "OpenCode 2.x goal orchestration with locked deterministic completion contracts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkmatter2222/opencode_mastergoal.git"
  },
  "exports": {
    ".": "./dist/server.js",
    "./tui": "./dist/tui.js",
    "./core": "./dist/engine.js",
    "./server": "./dist/server.js"
  },
  "bin": {
    "mastergoal": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "server.js",
    "tui.js",
    "scripts/build.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "verify": "npm run check && npm test && npm run benchmark",
    "prepack": "npm run build",
    "format": "prettier --write src test scripts benchmarks *.json *.js docs README.md CONTRIBUTING.md .github",
    "format:check": "prettier --check src test scripts benchmarks *.json *.js docs README.md CONTRIBUTING.md .github",
    "prepare": "npm run build",
    "test:install": "npm run build && node scripts/install-canary.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.22",
    "jsonc-parser": "3.3.1",
    "proper-lockfile": "^4.1.2",
    "@opentui/solid": "0.5.14",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  }
}
